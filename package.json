{
  "name": "@vibecodingstudio/opencode-remote-ssh",
  "version": "0.1.0",
  "description": "Session-scoped SSH tools and host management for OpenCode 2 TUI",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "license": "UNLICENSED",
  "repository": "github:VibeCodingStudio/opencode-remote-ssh",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./src/index.ts" },
    "./tui": "./src/tui/index.tsx",
    "./rpc": { "types": "./dist/rpc.d.ts", "import": "./src/rpc.ts" }
  },
  "files": ["dist", "src", "README.md", "GLOSSARY.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx test/run-integration.ts",
    "test:tui": "bun test --preload @opentui/solid/preload test/tui.test.tsx",
    "test:sdk": "bun test/run-sdk.ts",
    "test:vault": "bun test/vault-smoke.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "minimatch": "^10.2.6",
    "shell-quote": "^1.12.0",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.32",
    "@opentui/core": ">=0.5.17 <0.6",
    "@opentui/solid": ">=0.5.17 <0.6",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.32",
    "@opencode/sdk": "2.0.32",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/node": "^24.0.0",
    "@types/shell-quote": "^1.7.5",
    "@types/bun": "^1.3.10",
    "@types/ssh2": "^1.15.6",
    "solid-js": "1.9.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
